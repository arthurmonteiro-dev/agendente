# Banco de dados PostgreSQL
DATABASE_URL="postgresql://agendente:agendente@localhost:5432/agendente"

# Segredo para assinar sessões (mínimo 32 caracteres). Gere com: openssl rand -hex 32
SESSION_SECRET=""

# URL pública do app (usada para mostrar as URLs de webhook no painel)
APP_URL="http://localhost:3000"

# Protege GET /api/cron/tick (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=""   # token que você define no app da Meta ao cadastrar o webhook
WHATSAPP_APP_SECRET=""     # "App secret" do app da Meta — obrigatório em produção (valida a assinatura)
# WHATSAPP_GRAPH_VERSION="v21.0"

# Assistente com IA (Claude). Sem a chave, o robô de menu é usado.
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"
# AI_EFFORT="medium"        # low | medium | high

# E-mails com acesso ao /admin (separados por vírgula)
ADMIN_EMAILS=""
# SALES_EMAIL="contato@seudominio.com.br"

# Chave para criptografar tokens do WhatsApp no banco (64 hex). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se vazio, uma chave é derivada de SESSION_SECRET.
APP_ENCRYPTION_KEY=""

# Dados legais mostrados em /termos e /privacidade
LEGAL_COMPANY=""          # ex.: "Arthur Monteiro — CNPJ 00.000.000/0001-00" (enquanto não tiver CNPJ, deixe vazio)
LEGAL_CONTACT_EMAIL=""    # e-mail para dúvidas de privacidade (encarregado/DPO)
